<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ShoppetApp.Models"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             x:Class="ShoppetApp.Pages.CartPage"
             x:DataType="vm:CartViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,14,20,10" ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0"
                    WidthRequest="36"
                    HeightRequest="36"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBg}"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Path Aspect="Uniform"
                      HeightRequest="16"
                      WidthRequest="16"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Fill="{StaticResource SecondaryFg}"
                      Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" />
            </Border>
            <Label Grid.Column="1"
                   Text="Shopping Cart"
                   FontFamily="NunitoExtraBold"
                   FontSize="18"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{StaticResource SecondaryFg}" />
            <Border Grid.Column="2" WidthRequest="36" StrokeThickness="0" BackgroundColor="Transparent"/>
        </Grid>

        <!-- Cart Items -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10" Spacing="16">
                <CollectionView ItemsSource="{Binding CartService.Items}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="40">
                            <Label Text="Your cart is empty" FontFamily="NunitoBold" FontSize="16" TextColor="{StaticResource NavMuted}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CartItem">
                            <Border Stroke="{StaticResource Secondary10}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource CardBg}"
                                    Padding="12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" StrokeThickness="0" WidthRequest="80" HeightRequest="80">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding Product.ImageUrl}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Product.Name}" FontFamily="NunitoBold" FontSize="14" TextColor="{StaticResource SecondaryFg}" />
                                        <Label Text="{Binding Product.Price, StringFormat='${0:F2}'}" FontFamily="Nunito" FontSize="13" TextColor="{StaticResource NavMuted}" />
                                        <Label Text="{Binding TotalPrice, StringFormat='Total: ${0:F2}'}" FontFamily="NunitoExtraBold" FontSize="14" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" BackgroundColor="{StaticResource AppBackground}" Padding="4" HeightRequest="36">
                                            <RoundRectangle CornerRadius="18" Grid.ColumnSpan="3" Fill="{StaticResource AppBackground}" />
                                            <Button Grid.Column="0" Text="-" WidthRequest="32" HeightRequest="32" Padding="0" CornerRadius="16" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource SecondaryFg}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=DecreaseQuantityCommand}" CommandParameter="{Binding .}" />
                                            <Label Grid.Column="1" Text="{Binding Quantity}" FontFamily="NunitoBold" FontSize="14" VerticalOptions="Center" TextColor="{StaticResource SecondaryFg}" />
                                            <Button Grid.Column="2" Text="+" WidthRequest="32" HeightRequest="32" Padding="0" CornerRadius="16" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource SecondaryFg}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=IncreaseQuantityCommand}" CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Checkout Bottom Bar -->
        <Border Grid.Row="2"
                Stroke="{StaticResource Secondary10}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource CardBg}"
                Padding="20,16,20,32">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource SecondaryFg}" Offset="0,-4" Radius="16" Opacity="0.08" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="Total Price" FontFamily="Nunito" FontSize="12" TextColor="{StaticResource NavMuted}" />
                    <Label Text="{Binding CartService.CartTotal, StringFormat='${0:F2}'}" FontFamily="NunitoExtraBold" FontSize="22" TextColor="{StaticResource SecondaryFg}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Checkout"
                        FontFamily="NunitoBold"
                        FontSize="16"
                        HeightRequest="52"
                        WidthRequest="140"
                        CornerRadius="26"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        Command="{Binding CheckoutCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
