<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             x:Class="ShoppetApp.Pages.ContactFormPage"
             x:DataType="vm:ContactFormViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,24,16,32">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="✕" FontSize="18" BackgroundColor="Transparent" TextColor="Black" WidthRequest="40" Command="{Binding CloseCommand}" />
                <Label Grid.Column="1" Text="{Binding Title}" FontFamily="NunitoBold" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black" BackgroundColor="Transparent" />
                <Button Grid.Column="2" Text="Save" FontFamily="NunitoBold" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Command="{Binding SaveCommand}" />
            </Grid>

            <VerticalStackLayout Spacing="12">
                <Label Text="Name / Clinic *" FontFamily="NunitoSemiBold" FontSize="13" />
                <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Name}" Placeholder="Dr. Sarah Lee" HeightRequest="52" />
                </Border>

                <!-- Role Selection Picker -->
                <Label Text="Role / Description" FontFamily="NunitoSemiBold" FontSize="13" />
                <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Picker ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding Role}" ItemDisplayBinding="{Binding .}" TextColor="Black" BackgroundColor="Transparent" Title="Select Role" HeightRequest="44" />
                </Border>

                <Label Text="Phone Number *" FontFamily="NunitoSemiBold" FontSize="13" />
                <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Phone}" Keyboard="Numeric" MaxLength="11" Placeholder="09123456789" HeightRequest="52" TextChanged="OnPhoneTextChanged" />
                </Border>

                <Label Text="Address" FontFamily="NunitoSemiBold" FontSize="13" />
                <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Address}" Placeholder="123 Pet Lane" HeightRequest="52" />
                </Border>

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding IsEmergency}" Color="{StaticResource StatusOverdue}" />
                    <Label Text="Emergency Contact" FontFamily="Nunito" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button Text="Save Contact" Command="{Binding SaveCommand}" HeightRequest="52" CornerRadius="24" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryFg}" FontFamily="NunitoBold" />
            <Button Text="Delete Contact" IsVisible="{Binding CanDelete}" Command="{Binding DeleteCommand}" BackgroundColor="Transparent" TextColor="{StaticResource StatusOverdue}" FontFamily="Nunito" FontSize="14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>