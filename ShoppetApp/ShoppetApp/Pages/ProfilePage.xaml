<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ShoppetApp.Controls"
             xmlns:models="clr-namespace:ShoppetApp.Models"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             x:Class="ShoppetApp.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">
    <Grid>
        <Grid RowDefinitions="Auto,*">
            <controls:HeaderView Grid.Row="0" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16" Padding="20,8,20,108">

                    <!-- User Avatar & Name -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,16">
                        <Border WidthRequest="80"
                                HeightRequest="80"
                                BackgroundColor="{StaticResource Primary10}"
                                Stroke="{StaticResource Secondary}"
                                StrokeThickness="2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="40" />
                            </Border.StrokeShape>
                            <Label Text="👤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding FullName}"
                               FontFamily="NunitoExtraBold"
                               FontSize="20"
                               TextColor="{StaticResource SecondaryFg}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- ==========================================
                         RBAC: ADMIN / BUSINESS OWNER CONTROL PANEL
                         ========================================== -->
                    <Border BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="0"
                            Padding="16"
                            IsVisible="{Binding IsAdmin}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="🛡️ Admin Control Panel" FontFamily="NunitoBold" FontSize="14" TextColor="#1E2824"/>
                            <Button Text="Manage Platform Users &amp; Clinics" 
                                    BackgroundColor="#F7DD7D" TextColor="#16241F" FontAttributes="Bold" CornerRadius="12"
                                    Command="{Binding OpenAdminPanelCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="0"
                            Padding="16"
                            IsVisible="{Binding IsBusinessOwner}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="🏥 Clinic / Vet Shop Management" FontFamily="NunitoBold" FontSize="14" TextColor="#1E2824"/>
                            <Button Text="Manage Counter Orders &amp; Inventory" 
                                    BackgroundColor="#5C766D" TextColor="White" FontAttributes="Bold" CornerRadius="12"
                                    Command="{Binding OpenBusinessPanelCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Emergency Contacts Section (Your Existing Code) -->
                    <Border BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Black60}" Offset="0,2" Radius="10" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Emergency Contacts"
                                       FontFamily="NunitoBold"
                                       FontSize="16"
                                       TextColor="{StaticResource SecondaryFg}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Add Contact" Command="{Binding AddContactCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontFamily="NunitoBold" />
                            </Grid>
                            <SearchBar Placeholder="Search by role or name" Text="{Binding ContactSearchQuery}" BackgroundColor="Transparent" FontSize="14" Margin="0,-4,0,4" />
                            <CollectionView ItemsSource="{Binding Contacts}" SelectionMode="None" MaximumHeightRequest="230">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Contact">
                                        <Border Margin="0"
                                                Padding="12"
                                                BackgroundColor="{Binding IsEmergency, Converter={StaticResource EmergencyBgConverter}}"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                              <Border.GestureRecognizers>
                                                  <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=ViewContactDetailsCommand}" CommandParameter="{Binding .}" />
                                              </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontFamily="NunitoBold"
                                                           FontSize="14"
                                                           TextColor="{Binding IsEmergency, Converter={StaticResource EmergencyTextConverter}}" />
                                                    <Label Text="{Binding Role}"
                                                           FontFamily="Nunito"
                                                           FontSize="12"
                                                           TextColor="{StaticResource Secondary}" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource Primary10}" StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="20" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=EditContactCommand}" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="✏️" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Border Grid.Column="2" WidthRequest="40" HeightRequest="40" BackgroundColor="#1AFF3B30" StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="20" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=DeleteContactCommand}" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="🗑️" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Border Grid.Column="3" WidthRequest="40" HeightRequest="40" BackgroundColor="{Binding IsEmergency, Converter={StaticResource EmergencyPhoneBgConverter}}" StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="20" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=CallContactCommand}" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="📞" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Settings & Local Shops Section -->
                    <Border BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Black60}" Offset="0,2" Radius="10" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Settings &amp; Directory"
                                   FontFamily="NunitoBold"
                                   FontSize="16"
                                   TextColor="{StaticResource SecondaryFg}"
                                   Margin="0,0,0,8" />

                            <!-- Local Pet Shops Around Lipa Button Link -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <Label Text="📍 Local Lipa Pet Shops &amp; Clinics" FontFamily="Nunito" VerticalOptions="Center" />
                                <Label Text="➡️" FontSize="14" Grid.Column="1" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenLocalShopsCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary20}" />

                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <Label Text="Account Settings" FontFamily="Nunito" VerticalOptions="Center" />
                                <Label Text="➡️" FontSize="14" Grid.Column="1" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary20}" />

                            <HorizontalStackLayout Spacing="8" Padding="0,12">
                                <Label Text="🚪" FontSize="16" VerticalOptions="Center" />
                                <Label Text="Log Out"
                                       FontFamily="Nunito"
                                       TextColor="{StaticResource StatusOverdue}"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <controls:FloatingTabBar SelectedTab="profile"
                                 VerticalOptions="End" />
    </Grid>
</ContentPage>
