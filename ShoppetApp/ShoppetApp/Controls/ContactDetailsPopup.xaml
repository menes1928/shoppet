<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ShoppetApp.Models"
             x:Class="ShoppetApp.Controls.ContactDetailsPopup"
             x:DataType="models:Contact"
             BackgroundColor="#80000000">

    <Grid>
        <!-- Background tap to close -->
        <BoxView BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseClicked" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border BackgroundColor="White"
                WidthRequest="320"
                Padding="24"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="16">
                <Label Text="Contact Details" FontFamily="NunitoBold" FontSize="18" TextColor="{StaticResource SecondaryFg}" HorizontalOptions="Center" />
                
                <BoxView HeightRequest="1" Color="{StaticResource Secondary20}" />
                
                <VerticalStackLayout Spacing="4">
                    <Label Text="Name / Clinic" FontFamily="NunitoSemiBold" FontSize="12" TextColor="{StaticResource Secondary}" />
                    <Label Text="{Binding Name}" FontFamily="NunitoBold" FontSize="16" TextColor="Black" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Spacing="4">
                    <Label Text="Role / Description" FontFamily="NunitoSemiBold" FontSize="12" TextColor="{StaticResource Secondary}" />
                    <Label Text="{Binding Role}" FontFamily="Nunito" FontSize="14" TextColor="Black" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Phone Number" FontFamily="NunitoSemiBold" FontSize="12" TextColor="{StaticResource Secondary}" />
                    <Label Text="{Binding Phone}" FontFamily="Nunito" FontSize="14" TextColor="Black" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Address / Location" FontFamily="NunitoSemiBold" FontSize="12" TextColor="{StaticResource Secondary}" />
                    <Label Text="{Binding Address}" FontFamily="Nunito" FontSize="14" TextColor="Black" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsEmergency}">
                    <Label Text="🚨" FontSize="16" TextColor="{StaticResource StatusOverdue}" VerticalOptions="Center" />
                    <Label Text="Emergency Contact" FontFamily="NunitoSemiBold" FontSize="14" TextColor="{StaticResource StatusOverdue}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button Text="Close"
                        FontFamily="NunitoBold"
                        BackgroundColor="{StaticResource Secondary20}"
                        TextColor="{StaticResource SecondaryFg}"
                        CornerRadius="12"
                        HeightRequest="48"
                        Margin="0,16,0,0"
                        Clicked="OnCloseClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
