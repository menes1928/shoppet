<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ShoppetApp.Controls"
    xmlns:models="clr-namespace:ShoppetApp.Models"
    x:Class="ShoppetApp.Pages.CommunityPage"
    Title="Community"
    BackgroundColor="#F7F9F8">

    <ContentPage.Resources>

        <Color x:Key="Sage">#5C766D</Color>
        <Color x:Key="SageDark">#1E2D27</Color>
        <Color x:Key="SageSoft">#EEF4F1</Color>
        <Color x:Key="SageAccent">#7FA396</Color>
        <Color x:Key="White">#FFFFFF</Color>
        <Color x:Key="TextDark">#26342F</Color>
        <Color x:Key="TextMuted">#8A9691</Color>
        <Color x:Key="Border">#E4EBE7</Color>
        <Color x:Key="LikeRed">#E56B6F</Color>
        <Color x:Key="LikeGrey">#B0B8B4</Color>

    </ContentPage.Resources>

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="18,20,18,120" Spacing="20">

                <!-- PAGE HEADER -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Pet Community 🐾"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="{StaticResource SageDark}" />
                    <Label Text="Share moments and connect with fellow pet parents"
                           FontSize="14"
                           TextColor="{StaticResource TextMuted}" />
                    <Label x:Name="UserGreetingLabel"
                           Text="Browsing as Guest"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource SageAccent}"
                           Margin="0,6,0,0" />
                </VerticalStackLayout>

                <!-- CREATE POST CARD -->
                <Border BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource SageDark}" Offset="0,2" Radius="12" Opacity="0.05" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="✏️" FontSize="18" VerticalOptions="Center" />
                            <Label Text="Share a moment"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SageDark}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Pet Name -->
                        <Border BackgroundColor="#FAFCFB"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                Padding="14,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Entry x:Name="PetNameEntry"
                                   Placeholder="Your pet's name"
                                   FontSize="14"
                                   TextColor="{StaticResource TextDark}"
                                   PlaceholderColor="{StaticResource TextMuted}"
                                   BackgroundColor="Transparent" />
                        </Border>

                        <!-- Post Content -->
                        <Border BackgroundColor="#FAFCFB"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Editor x:Name="PostContentEditor"
                                    Placeholder="What's your pet up to today?"
                                    FontSize="14"
                                    TextColor="{StaticResource TextDark}"
                                    PlaceholderColor="{StaticResource TextMuted}"
                                    BackgroundColor="Transparent"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="100"
                                    TextChanged="OnPostContentTextChanged" />
                        </Border>

                        <!-- Mention Suggestions -->
                        <Border x:Name="MentionSuggestionsContainer"
                                IsVisible="False"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                Padding="4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <CollectionView x:Name="MentionSuggestionsView"
                                            SelectionMode="Single"
                                            SelectionChanged="OnMentionSelected"
                                            MaximumHeightRequest="200">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:User">
                                        <Grid Padding="10" ColumnDefinitions="Auto,*">
                                            <Border WidthRequest="36"
                                                    HeightRequest="36"
                                                    BackgroundColor="{StaticResource SageSoft}"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="18" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding FullName}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Sage}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Margin="10,0,0,0"
                                                                 VerticalOptions="Center"
                                                                 Spacing="1">
                                                <Label Text="{Binding FullName}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextDark}" />
                                                <Label Text="{Binding Role}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource TextMuted}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>

                        <!-- Attach photo row -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="AttachedFilesCountLabel"
                                   Text="No photos attached"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="📎  Attach Photo"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource SageDark}"
                                    BackgroundColor="{StaticResource SageSoft}"
                                    BorderColor="{StaticResource SageAccent}"
                                    BorderWidth="1"
                                    CornerRadius="20"
                                    Padding="14,8"
                                    Clicked="OnAttachPhotosClicked" />
                        </Grid>

                        <!-- Post Button -->
                        <Button Text="Post 🐾"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{StaticResource White}"
                                BackgroundColor="{StaticResource Sage}"
                                CornerRadius="14"
                                HeightRequest="50"
                                Clicked="OnPostClicked" />

                    </VerticalStackLayout>
                </Border>

                <!-- FEED TITLE -->
                <Label Text="Latest from the community"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource SageDark}"
                       Margin="4,8,0,0" />

                <!-- POSTS FEED -->
                <CollectionView x:Name="PostsCollection"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                Padding="32">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Label Text="🐶🐱"
                                       FontSize="44"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="No posts yet"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource SageDark}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Be the first to share a moment with the community."
                                       FontSize="13"
                                       TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CommunityPost">

                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    Padding="18"
                                    Margin="0,0,0,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource SageDark}" Offset="0,3" Radius="14" Opacity="0.05" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="14">

                                    <!-- HEADER: Avatar + Author + Menu -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                        <!-- Avatar circle -->
                                        <Border Grid.Column="0"
                                                WidthRequest="44"
                                                HeightRequest="44"
                                                BackgroundColor="{StaticResource SageSoft}"
                                                StrokeThickness="0"
                                                VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="22" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding AuthorName, Converter={StaticResource InitialsConverter}}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Sage}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Author + pet + time -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding AuthorName}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource SageDark}" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="🐾"
                                                       FontSize="11"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding PetName}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Sage}"
                                                       VerticalOptions="Center" />
                                                <Label Text="·"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextMuted}"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding FormattedTime}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource TextMuted}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Edit/Delete icon buttons — only for owner -->
                                        <HorizontalStackLayout Grid.Column="2"
                                                               Spacing="4"
                                                               IsVisible="{Binding CanEdit}"
                                                               VerticalOptions="Start">
                                            <Button Text="✏️"
                                                    FontSize="14"
                                                    WidthRequest="34"
                                                    HeightRequest="34"
                                                    Padding="0"
                                                    BackgroundColor="{StaticResource SageSoft}"
                                                    CornerRadius="17"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnEditPostClicked" />
                                            <Button Text="🗑️"
                                                    FontSize="14"
                                                    WidthRequest="34"
                                                    HeightRequest="34"
                                                    Padding="0"
                                                    BackgroundColor="#FCEEEE"
                                                    CornerRadius="17"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnDeletePostClicked" />
                                        </HorizontalStackLayout>

                                    </Grid>

                                    <!-- CONTENT -->
                                    <Label Text="{Binding Content}"
                                           FontSize="14"
                                           LineHeight="1.5"
                                           TextColor="{StaticResource TextDark}" />

                                    <!-- IMAGE -->
                                    <Border BackgroundColor="#F5F7F6"
                                            StrokeThickness="0"
                                            Padding="0"
                                            HorizontalOptions="Fill"
                                            IsVisible="{Binding HasImages}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding ImageUrls}"
                                               Aspect="AspectFill"
                                               HeightRequest="260"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill" />
                                    </Border>

                                    <!-- ACTION BAR -->
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="0,4,0,0">

                                        <!-- Like pill -->
                                        <Border Grid.Column="0"
                                                StrokeThickness="0"
                                                Padding="12,6"
                                                BackgroundColor="{StaticResource SageSoft}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnLikeTapped"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding IsLikedByMe, Converter={StaticResource HeartIconConverter}}"
                                                       FontSize="14"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding LikeCount}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource SageDark}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>

                                        <!-- Comment pill -->
                                        <Border Grid.Column="1"
                                                StrokeThickness="0"
                                                Padding="12,6"
                                                BackgroundColor="{StaticResource SageSoft}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnToggleCommentsTapped"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="💬"
                                                       FontSize="14"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding CommentCount}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource SageDark}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>

                                    </Grid>

                                    <!-- ═══════ COMMENTS PANEL (per post) ═══════ -->
                                    <VerticalStackLayout IsVisible="{Binding IsCommentsExpanded}"
                                                         Spacing="10"
                                                         Margin="0,6,0,0">

                                        <BoxView HeightRequest="1"
                                                 Color="{StaticResource Border}" />

                                        <!-- Existing comments -->
                                        <CollectionView ItemsSource="{Binding Comments}"
                                                        SelectionMode="None"
                                                        MaximumHeightRequest="320">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="models:CommunityComment">
                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="10"
                                                          Padding="0,6">

                                                        <!-- Avatar -->
                                                        <Border Grid.Column="0"
                                                                WidthRequest="32"
                                                                HeightRequest="32"
                                                                BackgroundColor="{StaticResource SageSoft}"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Start">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="16" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding AuthorName, Converter={StaticResource InitialsConverter}}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource Sage}"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />
                                                        </Border>

                                                        <!-- Comment bubble -->
                                                        <Border Grid.Column="1"
                                                                BackgroundColor="#F5F7F6"
                                                                StrokeThickness="0"
                                                                Padding="12,8">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="12" />
                                                            </Border.StrokeShape>
                                                            <VerticalStackLayout Spacing="2">
                                                                <HorizontalStackLayout Spacing="6">
                                                                    <Label Text="{Binding AuthorName}"
                                                                           FontSize="13"
                                                                           FontAttributes="Bold"
                                                                           TextColor="{StaticResource SageDark}" />
                                                                    <Label Text="·"
                                                                           FontSize="12"
                                                                           TextColor="{StaticResource TextMuted}" />
                                                                    <Label Text="{Binding TimeAgo}"
                                                                           FontSize="11"
                                                                           TextColor="{StaticResource TextMuted}" />
                                                                </HorizontalStackLayout>
                                                                <Label Text="{Binding Content}"
                                                                       FontSize="13"
                                                                       TextColor="{StaticResource TextDark}" />
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <!-- New comment input row -->
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8"
                                              Margin="0,4,0,0">

                                            <Border Grid.Column="0"
                                                    BackgroundColor="#FAFCFB"
                                                    Stroke="{StaticResource Border}"
                                                    StrokeThickness="1"
                                                    Padding="12,2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="18" />
                                                </Border.StrokeShape>
                                                <Entry Placeholder="Write a comment…"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextDark}"
                                                       PlaceholderColor="{StaticResource TextMuted}"
                                                       BackgroundColor="Transparent"
                                                       Completed="OnCommentSubmitted" />
                                            </Border>

                                            <Button Grid.Column="1"
                                                    Text="Send"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource White}"
                                                    BackgroundColor="{StaticResource Sage}"
                                                    CornerRadius="18"
                                                    Padding="16,8"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnSendCommentClicked" />
                                        </Grid>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating tab bar -->
        <controls:FloatingTabBar SelectedTab="community"
                                 VerticalOptions="End"
                                 HorizontalOptions="Fill" />

    </Grid>

</ContentPage>