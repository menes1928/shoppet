<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#4a7c82</Color>
    <Color x:Key="PrimaryFg">#ffffff</Color>
    <Color x:Key="Secondary">#9ab7a9</Color>
    <Color x:Key="SecondaryFg">#1c322e</Color>
    <Color x:Key="AppBackground">#fdfcf9</Color>
    <Color x:Key="CardBg">#ffffff</Color>
    <Color x:Key="Highlight">#f9e5a3</Color>
    <Color x:Key="Accent">#bcd4e6</Color>
    <Color x:Key="StatusHealthy">#8bc34a</Color>
    <Color x:Key="StatusHealthyBg">#f0f7e9</Color>
    <Color x:Key="StatusDue">#ffd54f</Color>
    <Color x:Key="StatusDueBg">#fffbf0</Color>
    <Color x:Key="StatusOverdue">#e57373</Color>
    <Color x:Key="StatusOverdueBg">#fdefef</Color>
    <Color x:Key="BodyText">#333333</Color>
    <Color x:Key="NavMuted">#7A9488</Color>

    <!-- Opacity variants (MAUI has no CSS-style /30 suffixes) -->
    <Color x:Key="Secondary30">#4D9ab7a9</Color>
    <Color x:Key="Secondary20">#339ab7a9</Color>
    <Color x:Key="Secondary10">#1A9ab7a9</Color>
    <Color x:Key="Secondary05">#0D9ab7a9</Color>
    <Color x:Key="Primary10">#1A4a7c82</Color>
    <Color x:Key="Primary20">#334a7c82</Color>
    <Color x:Key="Highlight30">#4Df9e5a3</Color>
    <Color x:Key="Accent30">#4Dbcd4e6</Color>
    <Color x:Key="White70">#B3FFFFFF</Color>
    <Color x:Key="White20">#33FFFFFF</Color>
    <Color x:Key="Black60">#99000000</Color>
    <Color x:Key="Amber800">#FF8F00</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    <Color x:Key="PrimaryDark">#3a6368</Color>
    <Color x:Key="PrimaryDarkText">#ffffff</Color>
    <Color x:Key="SecondaryDarkText">#1c322e</Color>
    <Color x:Key="Tertiary">#4a7c82</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>
    <Color x:Key="MidnightBlue">#1c322e</Color>
    <Color x:Key="Magenta">#e57373</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
